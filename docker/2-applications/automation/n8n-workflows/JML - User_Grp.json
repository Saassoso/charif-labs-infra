    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // ── 1. Parse the representation payload ──────────────────────\n  if (item.json.body && item.json.body.representation) {\n    try { item.json.userData = JSON.parse(item.json.body.representation); }\n    catch (e) { item.json.userData = {}; }\n  } else {\n    item.json.userData = {};\n  }\n\n  // ── 2. Extract email ──────────────────────────────────────────\n  const u = item.json.userData;\n  const email = u.email || u.username || '';\n  item.json.userEmail  = email;\n  item.json.emailDomain = email.includes('@') ? email.split('@')[1] : '';\n\n  // ── 3. Domain flags & Delete Event Override ───────────────────\n  const emailStr = email.toLowerCase();\n  const isItAdmin = emailStr.startsWith('it-admin') || emailStr.startsWith('admin');\n\n  // Initialize specific target emails\n  item.json.googleTargetEmail = email;\n  item.json.entraTargetEmail = email;\n\n  if (item.json.body.type === 'USER-DELETE' && !email.includes('@')) {\n    // If Keycloak deletes a user and strips the domain, route to BOTH platforms\n    item.json.isGoogleDomain = true;\n    item.json.isEntraDomain = true;\n    // Construct the proper emails so the APIs know who to suspend\n    item.json.googleTargetEmail = email + '@charif-labs.tech';\n    item.json.entraTargetEmail = email + '@ms.charif-labs.tech';\n  } else if (isItAdmin) {\n    item.json.isGoogleDomain = true;\n    item.json.isEntraDomain = true;\n  } else {\n    item.json.isGoogleDomain = (item.json.emailDomain === 'charif-labs.tech');\n    item.json.isEntraDomain  = (item.json.emailDomain === 'ms.charif-labs.tech');\n  }\n\n  // ── 4. Extract Keycloak user ID & Group UUID ──────────────────\n  item.json.keycloakUserId = null;\n  item.json.groupId = null;\n\n  if (item.json.body && item.json.body.resourcePath) {\n    const parts = item.json.body.resourcePath.split('/');\n    if (parts[0] === 'users' && parts.length > 1) {\n      item.json.keycloakUserId = parts[1];\n    }\n    if (item.json.body.type && item.json.body.type.includes('GROUP_MEMBERSHIP') && parts.length > 3) {\n      item.json.groupId = parts[3];\n    }\n  }\n\n  // ── 5. Extract Group Path from User Creation ──────────────────\n  item.json.groupPath = '';\n  if (u.groups && Array.isArray(u.groups) && u.groups.length > 0) {\n    item.json.groupPath = u.groups[0]; \n  }\n}\nreturn $input.all();"
      },
